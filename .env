# Azure B2C MSAL Configuration is loaded from backend:
#   GET {REACT_APP_API_URL}/api/auth/b2c-config
# No B2C values (tenant, client id, policies) are configured here.

# Frontend (port 3000)
# Prod: https://app.facilonservices.com
REACT_APP_REDIRECT_URI=http://localhost:4200
REACT_APP_POST_LOGOUT_URI=http://localhost:4200

# Client API (port 8080)
# Prod: https://app.facilonservices.com/client-api
REACT_APP_API_URL=http://localhost:8080/facilon

# User Management Service (port 8081)
# Prod: https://app.facilonservices.com/usr-mgmt
REACT_APP_USER_MGMT_URL=https://app.facilonservices.com/usr-mgmt
