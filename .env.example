# Azure B2C MSAL configuration is loaded at runtime from the backend:
#   GET {REACT_APP_API_URL}/api/auth/b2c-config
# Do NOT put B2C tenant, client id, or policy values here — they come from the backend.

# Redirect URIs
REACT_APP_REDIRECT_URI=http://localhost:3000
REACT_APP_POST_LOGOUT_URI=http://localhost:3000

# Backend API URL
REACT_APP_API_URL=http://localhost:8082/facilon
