# Azure B2C MSAL Configuration
# Replace these values with your actual Azure B2C settings

# Your B2C tenant name (e.g., facilonservices)
REACT_APP_B2C_TENANT=facilonservices

# Application (client) ID from Azure B2C app registration
REACT_APP_B2C_CLIENT_ID=54e55d9e-551a-4db4-b1e1-92fdb3e38c01

# User flow/policy names
REACT_APP_B2C_SIGNIN_POLICY=B2C_1_2Signin
REACT_APP_B2C_RESET_PASSWORD_POLICY=B2C_1_PasswordReset

# Redirect URIs
REACT_APP_REDIRECT_URI=http://localhost:3000
REACT_APP_POST_LOGOUT_URI=http://localhost:3000

# Backend API URL
REACT_APP_API_URL=http://localhost:8082/facilon
